[Unit]
Description=Nukleus web interface
Wants=network-online.target
After=network-online.target nukleus.service

[Service]
Type=simple
User=nukleus-web
Group=nukleus-web
EnvironmentFile=/etc/nukleus/nukleus-web.conf
ExecStart=/usr/local/libexec/nukleus/nukleus-web
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
