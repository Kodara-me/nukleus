[Unit]
Description=Kira Service image generation daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kira-service
Group=kira-service
@KIRA_SERVICE_GPU_GROUPS@
Environment=XDG_DATA_HOME=/var/lib/kira-service/data
Environment=TMPDIR=/run/kira-service
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/kira-service/kira-service.conf
ExecStart=/usr/local/libexec/kira-service/kira-service --listen ${KIRA_SERVICE_LISTEN} --port ${KIRA_SERVICE_PORT} --token-file ${KIRA_SERVICE_TOKEN_FILE}
StateDirectory=kira-service
StateDirectoryMode=0750
RuntimeDirectory=kira-service
RuntimeDirectoryMode=0750
UMask=0077
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kira-service /run/kira-service

[Install]
WantedBy=multi-user.target
