{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Nukleus",
            "type": "shell",
            "command": "cmake --build build --target nukleusd",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Build Nukleus Manager",
            "type": "shell",
            "command": "cmake --build build --target nukleus-manager",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
